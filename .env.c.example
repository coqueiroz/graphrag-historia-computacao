# Variáveis NOVAS da Parte C. Copie as que quiser para o seu .env (NUNCA versione o .env).
# As variáveis NEO4J_* continuam no .env da Parte B.

# ---------------- LLM (geração de texto) ----------------
# ollama    = PRINCIPAL: modelo local e gratuito (é o padrão se LLM_PROVIDER não for definido)
# none      = sem LLM (modo retrieval_only: mostra só as evidências)
# anthropic = alternativa opcional e paga (Claude); exige `pip install anthropic` e chave
LLM_PROVIDER=ollama
# vazio = padrão do provedor (ollama: qwen2.5:7b | anthropic: claude-opus-5-5)
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# janela de contexto (tokens) pedida ao Ollama; o padrão dele (4096) corta o prompt da Parte C
OLLAMA_NUM_CTX=12288
LLM_MAX_TOKENS=4000

# --- só para LLM_PROVIDER=anthropic (opcional) ---
# ANTHROPIC_API_KEY=coloque-sua-chave-aqui
# LLM_EFFORT=medium
# LLM_SERVER_FALLBACK=1

# ---------------- Recuperação GraphRAG ----------------
# auto = vetor+grafo e, com LLM, também Text-to-Cypher | vector | text2cypher
GRAPHRAG_STRATEGY=auto
GRAPHRAG_TOP_K=5
GRAPHRAG_HOPS=3
GRAPHRAG_MAX_PATHS_PER_SEED=60
GRAPHRAG_MAX_EDGES=30
GRAPHRAG_MIN_SEED_SCORE=0.55
GRAPHRAG_FULLTEXT_SEEDS=3
BASELINE_TOP_K=5

# ---------------- Limites de segurança ----------------
NEO4J_QUERY_TIMEOUT_S=15
T2C_MAX_ROWS=50
T2C_MAX_HOPS=4
MAX_CONTEXT_CHARS=14000
QUOTE_MAX_CHARS=600

# Opcional: usuário Neo4j só-leitura para o Text-to-Cypher (exige edição com papéis/RBAC)
NEO4J_READONLY_USER=
NEO4J_READONLY_PASSWORD=
