CREATE CONSTRAINT uniq_entidade_id IF NOT EXISTS FOR (n:Entidade) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_pessoa_id IF NOT EXISTS FOR (n:Pessoa) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_instituicao_id IF NOT EXISTS FOR (n:Instituicao) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_tecnologia_id IF NOT EXISTS FOR (n:Tecnologia) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_premio_id IF NOT EXISTS FOR (n:Premio) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_conceito_id IF NOT EXISTS FOR (n:Conceito) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_local_id IF NOT EXISTS FOR (n:Local) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT uniq_documento_doc_id IF NOT EXISTS FOR (d:Documento) REQUIRE d.doc_id IS UNIQUE;
CREATE CONSTRAINT uniq_chunk_chunk_id IF NOT EXISTS FOR (c:Chunk) REQUIRE c.chunk_id IS UNIQUE;
CREATE RANGE INDEX idx_entidade_name IF NOT EXISTS FOR (n:Entidade) ON (n.name);
CREATE RANGE INDEX idx_entidade_label IF NOT EXISTS FOR (n:Entidade) ON (n.label);
CREATE RANGE INDEX idx_chunk_doc_pos IF NOT EXISTS FOR (c:Chunk) ON (c.doc_id, c.position);
CREATE RANGE INDEX idx_documento_title IF NOT EXISTS FOR (d:Documento) ON (d.title);
CREATE RANGE INDEX idx_rel_trabalhou_em_chunk IF NOT EXISTS FOR ()-[r:TRABALHOU_EM]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_estudou_em_chunk IF NOT EXISTS FOR ()-[r:ESTUDOU_EM]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_criou_chunk IF NOT EXISTS FOR ()-[r:CRIOU]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_orientou_chunk IF NOT EXISTS FOR ()-[r:ORIENTOU]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_recebeu_chunk IF NOT EXISTS FOR ()-[r:RECEBEU]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_influenciou_chunk IF NOT EXISTS FOR ()-[r:INFLUENCIOU]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_colaborou_com_chunk IF NOT EXISTS FOR ()-[r:COLABOROU_COM]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_desenvolvido_em_chunk IF NOT EXISTS FOR ()-[r:DESENVOLVIDO_EM]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_baseado_em_chunk IF NOT EXISTS FOR ()-[r:BASEADO_EM]-() ON (r.chunk_id);
CREATE RANGE INDEX idx_rel_localizado_em_chunk IF NOT EXISTS FOR ()-[r:LOCALIZADO_EM]-() ON (r.chunk_id);
CREATE FULLTEXT INDEX ft_entidade_nome IF NOT EXISTS FOR (n:Entidade) ON EACH [n.name, n.aliases_text];
CREATE FULLTEXT INDEX ft_chunk_text IF NOT EXISTS FOR (c:Chunk) ON EACH [c.text];
CREATE FULLTEXT INDEX ft_relacao_evidence IF NOT EXISTS FOR ()-[r:TRABALHOU_EM|ESTUDOU_EM|CRIOU|ORIENTOU|RECEBEU|INFLUENCIOU|COLABOROU_COM|DESENVOLVIDO_EM|BASEADO_EM|LOCALIZADO_EM]-() ON EACH [r.evidence];
CREATE VECTOR INDEX vec_entidade_embedding IF NOT EXISTS FOR (n:Entidade) ON (n.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 384, `vector.similarity_function`: 'cosine'}};
CREATE VECTOR INDEX vec_chunk_embedding IF NOT EXISTS FOR (c:Chunk) ON (c.embedding) OPTIONS {indexConfig: {`vector.dimensions`: 384, `vector.similarity_function`: 'cosine'}};
